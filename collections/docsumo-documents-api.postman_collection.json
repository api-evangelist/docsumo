          "name": "Upload a document file",
          "request": {
            "name": "Upload a document file",
            "description": {
              "content": "Uploads a document file (.pdf, .png, .jpg, .jpeg, .tiff, .tif, and .xlsx for select financial types) for processing. The document is classified to the provided `type` and queued for extraction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "eevee",
                "apikey",
                "upload",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
